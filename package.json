{
  "name": "fred",
  "version": "0.2.5",
  "author": "",
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@effect/ai": "^0.35.0",
    "@effect/ai-anthropic": "^0.25.0",
    "@effect/ai-google": "^0.14.0",
    "@effect/ai-openai": "^0.39.0",
    "@effect/language-service": "^0.74.0",
    "@opentui/core": "^0.1.96",
    "@effect/opentelemetry": "^0.63.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-bun": "^0.89.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@types/bun": "^1.3.11",
    "@types/js-yaml": "^4.0.9",
    "@types/pg": "^8.20.0",
    "chokidar": "^5.0.0",
    "effect": "^3.21.0",
    "fast-deep-equal": "^3.1.3",
    "graphology": "^0.26.0",
    "graphology-dag": "^0.4.1",
    "js-yaml": "^4.1.1",
    "jsondiffpatch": "^0.7.3",
    "pg": "^8.20.0",
    "typescript": "^5.9.3"
  },
  "description": "Fred - A flexible framework for building AI agents with intent-based routing",
  "keywords": [
    "ai",
    "agents",
    "framework",
    "intent",
    "effect-ts"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "bun run packages/dev/src/dev-chat.ts",
    "server": "bun run packages/dev/src/server.ts",
    "build": "bun run --filter './packages/*' build",
    "test": "bun test --timeout 180000",
    "test:unit": "bun test --timeout 180000 tests/unit",
    "test:all": "bun run test",
    "test:smoke": "bun run scripts/verify.ts --smoke-only",
    "test:e2e": "bun run scripts/verify.ts --e2e-only",
    "typecheck": "bunx tsc --noEmit",
    "verify": "bun run scripts/verify.ts",
    "verify:live": "bun run scripts/verify.ts --live",
    "clean": "rm -rf packages/*/dist packages/*/node_modules",
    "changeset": "changeset",
    "docs:dev": "mkdocs serve",
    "docs:build": "mkdocs build",
    "docs:deploy": "mkdocs gh-deploy",
    "prepare": "effect-language-service patch",
    "ci:version": "changeset version && bun update",
    "ci:publish": "for dir in packages/*; do if [ -f \"$dir/package.json\" ] && grep -q '\"private\"[[:space:]]*:[[:space:]]*true' \"$dir/package.json\"; then echo \"Skipping private package $dir\"; continue; fi; (cd \"$dir\" && bun publish --tolerate-republish); done && changeset tag"
  },
  "type": "module",
  "workspaces": ["packages/*", "examples/*"],
  "dependencies": {
    "@fancyrobot/fred": "workspace:*",
    "@fancyrobot/fred-anthropic": "workspace:*",
    "@fancyrobot/fred-cli": "workspace:*",
    "@fancyrobot/fred-dev": "workspace:*",
    "@fancyrobot/fred-google": "workspace:*",
    "@fancyrobot/fred-groq": "workspace:*",
    "@fancyrobot/fred-openai": "workspace:*",
    "@fancyrobot/fred-openrouter": "workspace:*"
  }
}
