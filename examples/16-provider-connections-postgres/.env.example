# Use a disposable PostgreSQL database. The example creates only its configured
# Fred schema and a uniquely named sentinel schema, which it removes itself.
FRED_POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/fred_example
FRED_POSTGRES_SCHEMA=fred_example

# auto works whether pgvector is installed. Use required only when your app
# needs vector support; install requires CREATE privilege on the database.
FRED_PGVECTOR_MODE=auto
