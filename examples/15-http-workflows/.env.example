# The server and `fred keys create` must point at the same durable database.
FRED_HTTP_SQLITE_PATH=.fred/http.sqlite

# Paste the one-time output from the key creation command here for the client.
# Never commit the real value.
FRED_HTTP_API_KEY=fred_replace_me.with-the-one-time-secret

FRED_HTTP_URL=http://127.0.0.1:3000
PORT=3000
