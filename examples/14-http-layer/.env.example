# Required only for live chat. The smoke command does not need a provider key.
OPENROUTER_API_KEY=sk-or-your-key-here
FRED_EXAMPLE_MODEL=openrouter/free

# Uncomment to require bearer authentication for the standalone server.
# Generate a strong secret and never commit its real value.
# FRED_HTTP_AUTH_TOKEN=replace-with-a-long-random-secret

FRED_HTTP_URL=http://127.0.0.1:3000
PORT=3000
