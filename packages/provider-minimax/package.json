{
  "name": "@fancyrobot/fred-minimax",
  "version": "1.0.0",
  "description": "MiniMax multi-modality provider for Fred AI framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --external effect --external @effect/ai --external @effect/platform --external @effect/platform-bun --external @fancyrobot/fred",
    "build:declarations": "tsc --emitDeclarationOnly --outDir dist"
  },
  "peerDependencies": {
    "@fancyrobot/fred": "^1.0.0",
    "effect": "^3.21.0",
    "@effect/ai": "^0.35.0",
    "@effect/platform": "^0.96.0"
  },
  "devDependencies": {
    "effect": "^3.21.0",
    "@effect/ai": "^0.35.0",
    "@effect/platform": "^0.96.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fred",
    "minimax",
    "ai",
    "provider",
    "multi-modality",
    "image-generation",
    "video-generation",
    "speech",
    "voice",
    "music"
  ],
  "license": "MIT"
}
