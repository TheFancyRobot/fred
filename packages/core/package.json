{
  "name": "@fancyrobot/fred",
  "version": "1.0.0",
  "description": "Fred AI agent framework - core package",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./eval": {
      "types": "./dist/eval/public.d.ts",
      "bun": "./src/eval/public.ts",
      "import": "./dist/eval/public.js",
      "default": "./dist/eval/public.js"
    },
    "./context/sqlite": {
      "types": "./dist/context/storage/sqlite.d.ts",
      "bun": "./src/context/storage/sqlite.ts",
      "import": "./dist/context/storage/sqlite.js",
      "default": "./dist/context/storage/sqlite.js"
    },
    "./context/postgres": {
      "types": "./dist/context/storage/postgres.d.ts",
      "bun": "./src/context/storage/postgres.ts",
      "import": "./dist/context/storage/postgres.js",
      "default": "./dist/context/storage/postgres.js"
    },
    "./tools": {
      "types": "./dist/tool/calculator.d.ts",
      "bun": "./src/tool/calculator.ts",
      "import": "./dist/tool/calculator.js",
      "default": "./dist/tool/calculator.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "bun": "./src/effect/index.ts",
      "import": "./dist/effect/index.js",
      "default": "./dist/effect/index.js"
    },
    "./mcp/types": {
      "types": "./dist/mcp/types.d.ts",
      "bun": "./src/mcp/types.ts",
      "import": "./dist/mcp/types.js",
      "default": "./dist/mcp/types.js"
    },
    "./mcp/registry": {
      "types": "./dist/mcp/registry.d.ts",
      "bun": "./src/mcp/registry.ts",
      "import": "./dist/mcp/registry.js",
      "default": "./dist/mcp/registry.js"
    },
    "./tool/tool": {
      "types": "./dist/tool/tool.d.ts",
      "bun": "./src/tool/tool.ts",
      "import": "./dist/tool/tool.js",
      "default": "./dist/tool/tool.js"
    },
    "./stream": {
      "types": "./dist/stream/smooth-text.d.ts",
      "bun": "./src/stream/smooth-text.ts",
      "import": "./dist/stream/smooth-text.js",
      "default": "./dist/stream/smooth-text.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --external effect --external @effect/ai --external @effect/platform --external @effect/platform-bun --external @effect/platform-node",
    "build:declarations": "tsc --emitDeclarationOnly --outDir dist",
    "test": "bun test"
  },
  "peerDependencies": {
    "effect": "^3.21.0",
    "@effect/ai": "^0.35.0",
    "@effect/platform": "^0.96.0"
  },
  "dependencies": {
    "eta": "^4.5.1",
    "graphology": "^0.26.0",
    "graphology-dag": "^0.4.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "effect": "^3.21.0",
    "@effect/ai": "^0.35.0",
    "@effect/platform": "^0.96.0",
    "@types/js-yaml": "^4.0.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "agents",
    "framework",
    "effect",
    "typescript"
  ],
  "license": "MIT"
}
