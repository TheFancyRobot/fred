{
  "name": "@fancyrobot/fred",
  "version": "0.2.2",
  "description": "Fred AI agent framework - core package",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./eval": {
      "types": "./src/eval/public.ts",
      "import": "./src/eval/public.ts",
      "default": "./src/eval/public.ts"
    },
    "./context/sqlite": {
      "types": "./src/context/storage/sqlite.ts",
      "import": "./src/context/storage/sqlite.ts",
      "default": "./src/context/storage/sqlite.ts"
    },
    "./context/postgres": {
      "types": "./src/context/storage/postgres.ts",
      "import": "./src/context/storage/postgres.ts",
      "default": "./src/context/storage/postgres.ts"
    },
    "./tools": {
      "types": "./src/tool/calculator.ts",
      "import": "./src/tool/calculator.ts",
      "default": "./src/tool/calculator.ts"
    },
    "./effect": {
      "types": "./src/effect/index.ts",
      "import": "./src/effect/index.ts",
      "default": "./src/effect/index.ts"
    },
    "./mcp/types": {
      "types": "./src/mcp/types.ts",
      "import": "./src/mcp/types.ts",
      "default": "./src/mcp/types.ts"
    },
    "./mcp/registry": {
      "types": "./src/mcp/registry.ts",
      "import": "./src/mcp/registry.ts",
      "default": "./src/mcp/registry.ts"
    },
    "./tool/tool": {
      "types": "./src/tool/tool.ts",
      "import": "./src/tool/tool.ts",
      "default": "./src/tool/tool.ts"
    },
    "./stream": {
      "types": "./src/stream/smooth-text.ts",
      "import": "./src/stream/smooth-text.ts",
      "default": "./src/stream/smooth-text.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm",
    "test": "bun test"
  },
  "peerDependencies": {
    "effect": "^3.21.0",
    "@effect/ai": "^0.35.0",
    "@effect/platform": "^0.96.0"
  },
  "dependencies": {
    "eta": "^4.5.1",
    "graphology": "^0.26.0",
    "graphology-dag": "^0.4.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "effect": "^3.21.0",
    "@effect/ai": "^0.35.0",
    "@effect/platform": "^0.96.0",
    "@types/js-yaml": "^4.0.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "agents",
    "framework",
    "effect",
    "typescript"
  ],
  "license": "MIT"
}
