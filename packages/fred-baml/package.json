{
  "name": "@fancyrobot/fred-baml",
  "version": "0.1.0",
  "description": "BAML integration helpers for the Fred AI framework",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm"
  },
  "peerDependencies": {
    "@fancyrobot/fred": "^1.0.0",
    "effect": "^3.21.0",
    "@boundaryml/baml": "*"
  },
  "peerDependenciesMeta": {
    "@boundaryml/baml": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fancyrobot/fred": "workspace:^",
    "effect": "^3.21.0",
    "@boundaryml/baml": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fred",
    "baml",
    "ai",
    "agents"
  ],
  "license": "MIT"
}
