{
  "name": "@fancyrobot/fred-anthropic",
  "version": "3.0.0",
  "description": "Anthropic provider for Fred AI framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --external effect --external @effect/ai --external @effect/ai-anthropic --external @fancyrobot/fred",
    "build:declarations": "tsc --emitDeclarationOnly --outDir dist"
  },
  "peerDependencies": {
    "@fancyrobot/fred": "^1.0.0",
    "effect": "^3.21.0",
    "@effect/ai": "^0.35.0",
    "@effect/ai-anthropic": "^0.25.0"
  },
  "devDependencies": {
    "effect": "^3.21.0",
    "@effect/ai": "^0.35.0",
    "@effect/ai-anthropic": "^0.25.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fred",
    "anthropic",
    "claude",
    "ai",
    "provider"
  ],
  "license": "MIT"
}
