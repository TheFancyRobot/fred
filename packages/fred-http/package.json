{
  "name": "@fancyrobot/fred-http",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheFancyRobot/fred.git",
    "directory": "packages/fred-http"
  },
  "description": "Fred Bun HTTP server and composable HTTP app tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --external effect --external @effect/platform --external @effect/platform-bun --external @fancyrobot/fred --external @fancyrobot/fred-postgres",
    "build:declarations": "tsc --emitDeclarationOnly --outDir dist"
  },
  "dependencies": {
    "@fancyrobot/fred-postgres": "^1.0.0"
  },
  "peerDependencies": {
    "@fancyrobot/fred": "^2.0.0",
    "effect": "^3.21.5",
    "@effect/platform": "^0.96.2",
    "@effect/platform-bun": "^0.89.0"
  },
  "devDependencies": {
    "effect": "^3.21.5",
    "@effect/platform": "^0.96.2",
    "@effect/platform-bun": "^0.89.0",
    "@types/bun": "1.3.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fred",
    "http",
    "bun",
    "api"
  ],
  "license": "MIT"
}
