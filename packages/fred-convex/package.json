{
  "name": "@fancyrobot/fred-convex",
  "version": "0.1.0",
  "description": "Convex integration helpers for the Fred AI framework",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts src/testing.ts --outdir dist --target bun --format esm"
  },
  "peerDependencies": {
    "@fancyrobot/fred": "^1.0.0",
    "convex": "^1.0.0",
    "effect": "^3.21.0"
  },
  "devDependencies": {
    "convex": "^1.0.0",
    "effect": "^3.21.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fred",
    "convex",
    "ai",
    "agents"
  ],
  "license": "MIT"
}
