{
  "name": "@fancyrobot/fred-openai",
  "version": "4.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheFancyRobot/fred.git",
    "directory": "packages/provider-openai"
  },
  "description": "OpenAI provider for Fred AI framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --external effect --external @effect/ai --external @effect/ai-openai --external @fancyrobot/fred",
    "build:declarations": "tsc --emitDeclarationOnly --outDir dist"
  },
  "peerDependencies": {
    "@fancyrobot/fred": "^2.0.0-alpha.0",
    "effect": "^3.21.0",
    "@effect/ai": "^0.35.0",
    "@effect/ai-openai": "^0.39.0"
  },
  "devDependencies": {
    "effect": "^3.21.0",
    "@effect/ai": "^0.35.0",
    "@effect/ai-openai": "^0.39.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fred",
    "openai",
    "ai",
    "provider"
  ],
  "license": "MIT"
}
