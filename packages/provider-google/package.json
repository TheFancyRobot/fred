{
  "name": "@fancyrobot/fred-google",
  "version": "4.0.0-alpha.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheFancyRobot/fred.git",
    "directory": "packages/provider-google"
  },
  "description": "Google (Gemini) provider for Fred AI framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --external effect --external @effect/ai --external @effect/ai-google --external @effect/platform --external @fancyrobot/fred",
    "build:declarations": "tsc --emitDeclarationOnly --outDir dist"
  },
  "peerDependencies": {
    "@fancyrobot/fred": "^2.0.0-alpha.0",
    "effect": "^3.21.5",
    "@effect/ai": "^0.35.0",
    "@effect/ai-google": "^0.14.0",
    "@effect/platform": "^0.96.0"
  },
  "devDependencies": {
    "effect": "^3.21.5",
    "@effect/ai": "^0.35.0",
    "@effect/ai-google": "^0.14.0",
    "@effect/platform": "^0.96.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fred",
    "google",
    "gemini",
    "ai",
    "provider"
  ],
  "license": "MIT"
}
