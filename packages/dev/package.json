{
  "name": "@fancyrobot/fred-dev",
  "version": "0.2.1",
  "description": "Fred AI framework development tools",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./chat-defaults": {
      "types": "./src/chat-defaults.ts",
      "import": "./src/chat-defaults.ts"
    }
  },
  "scripts": {
    "dev": "bun run src/dev-chat.ts",
    "server": "bun run src/server.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --format esm"
  },
  "dependencies": {
    "@fancyrobot/fred": "workspace:^",
    "chokidar": "^5.0.0"
  },
  "peerDependencies": {
    "effect": "^3.21.0",
    "@effect/platform-bun": "^0.89.0"
  },
  "devDependencies": {
    "effect": "^3.21.0",
    "@effect/platform-bun": "^0.89.0",
    "@types/bun": "latest"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fred",
    "dev",
    "cli",
    "development"
  ],
  "license": "MIT"
}
