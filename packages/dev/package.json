{
  "name": "@fancyrobot/fred-dev",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheFancyRobot/fred.git",
    "directory": "packages/dev"
  },
  "description": "Deprecated compatibility shim for @fancyrobot/fred-cli",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./chat-defaults": {
      "types": "./dist/chat-defaults.d.ts",
      "bun": "./src/chat-defaults.ts",
      "import": "./dist/chat-defaults.js",
      "default": "./dist/chat-defaults.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts src/chat-defaults.ts --root src --outdir dist --target bun --format esm --external @fancyrobot/fred-cli",
    "build:declarations": "rm -rf dist tsconfig.tsbuildinfo && tsc --emitDeclarationOnly --outDir dist"
  },
  "peerDependencies": {
    "@fancyrobot/fred-cli": "^0.7.0"
  },
  "devDependencies": {
    "@fancyrobot/fred-cli": "workspace:^",
    "@types/bun": "1.3.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "deprecated": "Compatibility shim only. Install @fancyrobot/fred-cli and use `fred chat`; @fancyrobot/fred-dev will be removed in the next major release.",
  "keywords": [
    "fred",
    "dev",
    "cli",
    "development"
  ],
  "license": "MIT"
}
