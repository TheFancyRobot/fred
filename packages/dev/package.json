{
  "name": "@fancyrobot/fred-dev",
  "version": "1.0.0-alpha.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheFancyRobot/fred.git",
    "directory": "packages/dev"
  },
  "description": "Fred dev-only tooling and contributor workflows",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./chat-defaults": {
      "types": "./dist/chat-defaults.d.ts",
      "bun": "./src/chat-defaults.ts",
      "import": "./dist/chat-defaults.js",
      "default": "./dist/chat-defaults.js"
    }
  },
  "scripts": {
    "dev": "bun run src/dev-chat.ts",
    "server": "bun run src/server.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --external effect --external @effect/platform-bun --external @fancyrobot/fred --external @fancyrobot/fred-http",
    "build:declarations": "tsc --emitDeclarationOnly --outDir dist"
  },
  "dependencies": {
    "chokidar": "^5.0.0"
  },
  "peerDependencies": {
    "@fancyrobot/fred": "^2.0.0-alpha.0",
    "@fancyrobot/fred-http": "^1.0.0-alpha.0",
    "effect": "^3.21.0",
    "@effect/platform-bun": "^0.89.0"
  },
  "devDependencies": {
    "effect": "^3.21.0",
    "@effect/platform-bun": "^0.89.0",
    "@types/bun": "latest"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fred",
    "dev",
    "cli",
    "development"
  ],
  "license": "MIT"
}
