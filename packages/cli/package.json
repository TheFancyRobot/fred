{
  "name": "@fancyrobot/fred-cli",
  "version": "0.2.2",
  "description": "Fred AI framework CLI",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./plugin": {
      "types": "./src/plugin/api.ts",
      "import": "./src/plugin/api.ts",
      "default": "./src/plugin/api.ts"
    }
  },
  "bin": {
    "fred": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm"
  },
  "dependencies": {
    "@fancyrobot/fred": "workspace:^",
    "@fancyrobot/fred-anthropic": "workspace:^",
    "@fancyrobot/fred-dev": "workspace:^",
    "@fancyrobot/fred-google": "workspace:^",
    "@fancyrobot/fred-groq": "workspace:^",
    "@fancyrobot/fred-openai": "workspace:^",
    "@fancyrobot/fred-openrouter": "workspace:^",
    "@opentui/core": "^0.1.77",
    "semver": "^7.7.4"
  },
  "peerDependencies": {
    "effect": "^3.19.0"
  },
  "devDependencies": {
    "effect": "^3.19.15",
    "@types/bun": "latest"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fred",
    "cli",
    "ai",
    "agents"
  ],
  "license": "MIT"
}
