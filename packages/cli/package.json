{
  "name": "@fancyrobot/fred-cli",
  "version": "0.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheFancyRobot/fred.git",
    "directory": "packages/cli"
  },
  "description": "Fred AI framework CLI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/api.d.ts",
      "bun": "./src/plugin/api.ts",
      "import": "./dist/plugin/api.js",
      "default": "./dist/plugin/api.js"
    },
    "./chat-defaults": {
      "types": "./dist/chat-defaults.d.ts",
      "bun": "./src/chat-defaults.ts",
      "import": "./dist/chat-defaults.js",
      "default": "./dist/chat-defaults.js"
    }
  },
  "bin": {
    "fred": "./dist/index.js"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/plugin/api.ts src/chat-defaults.ts --root src --outdir dist --target bun --format esm --external effect --external @fancyrobot/fred --external @fancyrobot/fred-openai --external @fancyrobot/fred-anthropic --external @fancyrobot/fred-google --external @fancyrobot/fred-groq --external @fancyrobot/fred-minimax --external @fancyrobot/fred-openrouter --external @fancyrobot/fred-http --external @fancyrobot/fred-postgres --external pg --external @opentui/core --external semver",
    "build:declarations": "tsc --emitDeclarationOnly --outDir dist"
  },
  "dependencies": {
    "@fancyrobot/fred": "^2.1.0",
    "@fancyrobot/fred-anthropic": "^4.1.0",
    "@fancyrobot/fred-google": "^4.1.0",
    "@fancyrobot/fred-groq": "^4.1.0",
    "@fancyrobot/fred-minimax": "^2.1.0",
    "@fancyrobot/fred-openai": "^4.1.0",
    "@fancyrobot/fred-openrouter": "^5.1.0",
    "@fancyrobot/fred-postgres": "^1.0.0",
    "@opentui/core": "^0.1.92",
    "semver": "^7.7.4"
  },
  "peerDependencies": {
    "effect": "^3.21.0"
  },
  "optionalDependencies": {
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "effect": "^3.21.0",
    "@types/semver": "^7.7.1",
    "@types/bun": "1.3.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fred",
    "cli",
    "ai",
    "agents"
  ],
  "license": "MIT"
}
