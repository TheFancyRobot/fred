{
  "name": "@fancyrobot/fred-cli",
  "version": "0.5.1-alpha.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheFancyRobot/fred.git",
    "directory": "packages/cli"
  },
  "description": "Fred AI framework CLI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/api.d.ts",
      "bun": "./src/plugin/api.ts",
      "import": "./dist/plugin/api.js",
      "default": "./dist/plugin/api.js"
    }
  },
  "bin": {
    "fred": "./dist/index.js"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/plugin/api.ts --root src --outdir dist --target bun --format esm --external effect --external @fancyrobot/fred --external @fancyrobot/fred-openai --external @fancyrobot/fred-anthropic --external @fancyrobot/fred-google --external @fancyrobot/fred-groq --external @fancyrobot/fred-openrouter --external @fancyrobot/fred-dev --external @fancyrobot/fred-http --external pg --external @opentui/core --external semver",
    "build:declarations": "tsc --emitDeclarationOnly --outDir dist"
  },
  "dependencies": {
    "@fancyrobot/fred": "workspace:^",
    "@fancyrobot/fred-anthropic": "workspace:^",
    "@fancyrobot/fred-dev": "workspace:^",
    "@fancyrobot/fred-google": "workspace:^",
    "@fancyrobot/fred-groq": "workspace:^",
    "@fancyrobot/fred-openai": "workspace:^",
    "@fancyrobot/fred-openrouter": "workspace:^",
    "@opentui/core": "^0.1.92",
    "semver": "^7.7.4"
  },
  "peerDependencies": {
    "effect": "^3.21.0"
  },
  "optionalDependencies": {
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "effect": "^3.21.0",
    "@types/bun": "latest"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fred",
    "cli",
    "ai",
    "agents"
  ],
  "license": "MIT"
}
